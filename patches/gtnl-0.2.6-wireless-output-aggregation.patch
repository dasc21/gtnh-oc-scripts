+    private static ItemStack[] mergeWirelessItemOutputs(ItemStack[] current, ItemStack[] incoming) {
+        List<ItemStack> merged = new ArrayList<>();
+        appendItemOutputs(merged, current);
+        appendItemOutputs(merged, incoming);
+        return merged.isEmpty() ? null : merged.toArray(new ItemStack[0]);
+    }
+
+    private static void appendItemOutputs(List<ItemStack> merged, ItemStack[] source) {
+        if (source == null) return;
+
+        for (ItemStack stack : source) {
+            if (stack == null || stack.stackSize <= 0) continue;
+
+            long remaining = stack.stackSize;
+            for (ItemStack existing : merged) {
+                if (!GTUtility.areStacksEqual(existing, stack)) continue;
+
+                long room = (long) Integer.MAX_VALUE - existing.stackSize;
+                if (room <= 0) continue;
+
+                int moved = (int) Math.min(room, remaining);
+                existing.stackSize += moved;
+                remaining -= moved;
+                if (remaining == 0) break;
+            }
+
+            while (remaining > 0) {
+                ItemStack copy = stack.copy();
+                copy.stackSize = (int) Math.min(Integer.MAX_VALUE, remaining);
+                merged.add(copy);
+                remaining -= copy.stackSize;
+            }
+        }
+    }
+
+    private static FluidStack[] mergeWirelessFluidOutputs(FluidStack[] current, FluidStack[] incoming) {
+        List<FluidStack> merged = new ArrayList<>();
+        appendFluidOutputs(merged, current);
+        appendFluidOutputs(merged, incoming);
+        return merged.isEmpty() ? null : merged.toArray(new FluidStack[0]);
+    }
+
+    private static void appendFluidOutputs(List<FluidStack> merged, FluidStack[] source) {
+        if (source == null) return;
+
+        for (FluidStack stack : source) {
+            if (stack == null || stack.amount <= 0) continue;
+
+            long remaining = stack.amount;
+            for (FluidStack existing : merged) {
+                if (!GTUtility.areFluidsEqual(existing, stack)) continue;
+
+                long room = (long) Integer.MAX_VALUE - existing.amount;
+                if (room <= 0) continue;
+
+                int moved = (int) Math.min(room, remaining);
+                existing.amount += moved;
+                remaining -= moved;
+                if (remaining == 0) break;
+            }
+
+            while (remaining > 0) {
+                FluidStack copy = stack.copy();
+                copy.amount = (int) Math.min(Integer.MAX_VALUE, remaining);
+                merged.add(copy);
+                remaining -= copy.amount;
+            }
+        }
+    }
+
+    private static int countNonNull(ItemStack[] stacks) {
+        if (stacks == null) return 0;
+        int count = 0;
+        for (ItemStack stack : stacks) if (stack != null) count++;
+        return count;
+    }
+
+    private static int countNonNull(FluidStack[] stacks) {
+        if (stacks == null) return 0;
+        int count = 0;
+        for (FluidStack stack : stacks) if (stack != null) count++;
+        return count;
+    }
+
+    private static ItemStack[] firstNonNull(ItemStack[] stacks, int limit) {
+        if (stacks == null || limit <= 0) return null;
+        List<ItemStack> result = new ArrayList<>(Math.min(stacks.length, limit));
+        for (ItemStack stack : stacks) {
+            if (stack == null) continue;
+            result.add(stack);
+            if (result.size() >= limit) break;
+        }
+        return result.isEmpty() ? null : result.toArray(new ItemStack[0]);
+    }
+
+    private static FluidStack[] firstNonNull(FluidStack[] stacks, int limit) {
+        if (stacks == null || limit <= 0) return null;
+        List<FluidStack> result = new ArrayList<>(Math.min(stacks.length, limit));
+        for (FluidStack stack : stacks) {
+            if (stack == null) continue;
+            result.add(stack);
+            if (result.size() >= limit) break;
+        }
+        return result.isEmpty() ? null : result.toArray(new FluidStack[0]);
+    }
 
